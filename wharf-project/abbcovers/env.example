# Copy to /srv/wharf/projects/abbcovers/.env on the node (mode 600, owned by
# the wharf user). Any shim account works — the cover routes are member-level.
ABS_SHIM_URL=https://abs-shim.jderrick.app
ABS_SHIM_USER=
ABS_SHIM_PASS=
# Label in /admin's catalogue card. Defaults to the hostname.
NODE_NAME=
# id % ABS_SHIM_SHARDS == ABS_SHIM_SHARD, so several runners (nodes, or the
# Mac) can share the backlog without resizing the same image twice. One
# runner = SHARD 0 of SHARDS 1.
ABS_SHIM_SHARD=0
ABS_SHIM_SHARDS=1
