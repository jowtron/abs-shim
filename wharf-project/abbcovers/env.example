# Copy to /srv/wharf/projects/abbcovers/.env on the node (mode 600, owned by
# the wharf user). The key is this node's, made in /admin → Catalogue →
# Node keys (shown once; the same key goes in abbcrawl's .env as
# SHIM_NODE_KEY). No user or password is needed with a key.
ABS_SHIM_URL=https://rhapsode.jderrick.app
ABS_SHIM_NODE_KEY=
# Label in /admin's catalogue card. With a key the shim uses the key's own
# name whatever this says, so keep them the same.
NODE_NAME=
# id % ABS_SHIM_SHARDS == ABS_SHIM_SHARD, so several runners (nodes, or the
# Mac) can share the backlog without resizing the same image twice. One
# runner = SHARD 0 of SHARDS 1.
ABS_SHIM_SHARD=0
ABS_SHIM_SHARDS=1
