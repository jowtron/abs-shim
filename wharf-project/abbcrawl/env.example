# Copy to /srv/wharf/projects/abbcrawl/.env on the node (mode 600, owned by
# the wharf user). SHIM_USER must be the tenant OWNER — the claim/submit
# routes are owner-only.
SHIM_URL=https://abs-shim.jderrick.app
SHIM_USER=
SHIM_PASS=
# Label in /admin's crawler card. Defaults to the hostname.
NODE_NAME=
# Seconds between ABB fetches. 8 ≈ 7 pages/min per node — well under the
# ~17/min burst that got the dev Mac firewalled, and two nodes at this pace
# clear a 10k backlog in about a day.
PACE_SECONDS=8
BATCH=10
IDLE_SLEEP=600

# ─── cover runner (abb-covers service) ───────────────────────────────────────
# Same account as above; the covers routes are member-level but there's no
# reason to use a second one.
ABS_SHIM_URL=https://abs-shim.jderrick.app
ABS_SHIM_USER=
ABS_SHIM_PASS=
# id % ABS_SHIM_SHARDS == ABS_SHIM_SHARD. With two nodes: 0/2 and 1/2.
ABS_SHIM_SHARD=0
ABS_SHIM_SHARDS=2
