# Copy to /srv/wharf/projects/abbcrawl/.env on the node (mode 600, owned by
# the wharf user). The key is this node's, made in /admin → Catalogue →
# Node keys (shown once; the same key goes in abbcovers' .env as
# ABS_SHIM_NODE_KEY). It opens only the catalogue's node routes, so the
# owner's password never has to be on the node (it was until 2026-10-14).
SHIM_URL=https://rhapsode.jderrick.app
SHIM_NODE_KEY=
# Label in /admin's crawler card. With a key the shim uses the key's own
# name whatever this says, so keep them the same.
NODE_NAME=
# Seconds between ABB fetches. 8 ≈ 7 pages/min per node — well under the
# ~17/min burst that got the dev Mac firewalled, and two nodes at this pace
# clear a 10k backlog in about a day.
PACE_SECONDS=8
BATCH=10
IDLE_SLEEP=600
